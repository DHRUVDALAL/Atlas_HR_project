# docker-compose overrides. Copy to `.env` and set real values for anything
# beyond local development. Sensible dev defaults are baked into
# docker-compose.yml, so the stack runs without this file — but you MUST set a
# strong SECRET_KEY and SEED_ADMIN_PASSWORD for any shared/production use.

POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SEED_ADMIN_EMAIL=admin@atlas.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
