# PostgreSQL
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# Database URL (constructed from above)
DATABASE_URL=postgresql+psycopg2://atlas:atlas@db:5432/atlas

# JWT Authentication
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin (first run only)
SEED_ADMIN_EMAIL=admin@atlas.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123

# Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ATLAS HR System
SMTP_FROM_EMAIL=noreply@atlas.com
SMTP_USE_TLS=true

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Background Verification
BGV_PROVIDER=mock
