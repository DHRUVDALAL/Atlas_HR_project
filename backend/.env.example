# PostgreSQL connection string.
# When running via docker-compose the host is the "db" service name.
DATABASE_URL=postgresql+psycopg2://atlas:atlas@db:5432/atlas

# JWT signing. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Bootstrap admin created by the seeder (first run only). Choose a strong password.
SEED_ADMIN_EMAIL=admin@atlas.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
