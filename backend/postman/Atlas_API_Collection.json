                  "raw": "{\n  \"email\": \"admin@atlas.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "login"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiYTQ3N2Y5ZTctMzZkYy00OGY1LTk0YWQtZjEyNmQ0ODFjOTI2IiwiZW1haWwiOiJhZG1pbkBhdGxhcy5jb20iLCJyb2xlIjoiU1lTVEVNX0FETUlOIiwiZXhwIjoxNzgyMDU1MTY3fQ.example\",\n  \"role\": \"SYSTEM_ADMIN\",\n  \"message\": \"Welcome System Admin\"\n}"
