{
  "info": {
    "_postman_id": "atlas-api-collection-2026",
    "name": "ATLAS Interview Management System API",
    "description": "Complete API collection for the ATLAS Interview Management System.\n\nThis collection covers:\n- Authentication (Login, Current User)\n- Protected Endpoints\n- Role-Based Dashboard Access (Admin, HR, Tech, Reception)\n\n## Authentication\nAll protected endpoints require a JWT Bearer token. Use the Login endpoint to obtain a token, then set it as the `token` collection variable.\n\n## Roles\n- SYSTEM_ADMIN: Full access\n- HR_ADMIN: HR dashboard access\n- TECH_HEAD: Tech dashboard access\n- RECEPTIONIST: Reception dashboard access",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "{{base_url}}",
      "type": "string"
    },
    {
      "key": "token",
      "value": "{{token}}",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Authentication endpoints for user login and profile retrieval",
      "item": [
        {
          "name": "Login - System Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.test('Login successful', function() {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.token).to.be.a('string');",
                  "        pm.expect(jsonData.role).to.equal('SYSTEM_ADMIN');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate as System Admin and obtain a JWT token.\n\nThe token is automatically saved to the `token` environment/collection variable for use in subsequent requests.\n\n**Roles:** Public\n**Auth:** None required"
          },
          "response": [
            {
              "name": "200 - Successful Login",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
