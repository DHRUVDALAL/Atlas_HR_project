# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Databases (use PostgreSQL via Docker; never commit data)
*.db
*.db.bak
*.sqlite
*.sqlite3

# Editor backups / scratch
*.bak
*.new
*_output.txt

# Node (should not exist in a Python backend)
node_modules/
package.json
package-lock.json

# User uploads (runtime data / PII — never commit)
uploads/**
!uploads/.gitkeep

# Test / tooling
.pytest_cache/
.coverage
htmlcov/
